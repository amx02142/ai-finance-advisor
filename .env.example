# Copy this file to ".env" (same folder as app.py) and paste your Gemini key.
# Free key: https://aistudio.google.com/apikey
# The app works without a key (offline mode), but AI features need it.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: choose a different model (the app falls back automatically if it is unavailable)
# GEMINI_MODEL=gemini-3.5-flash
